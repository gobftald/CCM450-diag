#define CONZEPT_KWP2000	 0x0C
#define CONZEPT_BMW_FAST 0x0F
#define CONZEPT_D_CAN	 0x10

#define TESTER_ADDRESS_VALUE 0x12                   // we call it Control Unit as well

// global/shared memory
