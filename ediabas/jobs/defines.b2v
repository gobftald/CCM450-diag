#define FALSE 0
#define FAILED 0
#define TRUE 1
#define SUCCESS 1
#define FOUND 1

#define LIN_KWP2000 FALSE

#define SecurityLevel_1_normal 0x01
#define SecurityLevel_ID1_normal 0x01
#define SecurityLevel_ID1_response 0x02

#define SecurityLevel_2_secure 0x02
#define SecurityLevel_ID2_secure 0x03
#define SecurityLevel_ID2_response 0x04

#define AccessMode_position 4

#define DIAGNOSEKONZEPT_1 1
#define DIAGNOSEKONZEPT_2 2

