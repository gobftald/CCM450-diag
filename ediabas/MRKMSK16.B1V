            jz          B2_160_4b              ; ja -> goto %4b
            wait        #1               ; wait (1)

B2_160_4b:        subb        I6,#1            ; BusyCount --
            jnz         B2_160_1a              ; BusyCount > 0 -> goto %1a

B2_160_4a:        fix2hex     S1,S4[B0]       ;
            tabseek     "SB",S1          ; tab_suche_index("SB",antwort[offset+2])
