		jump		__B2_HD_00181					; end of switch
__B2_HD_00182:
		pop 		L0					; get expression
		comp		L0,#$6				; 
		jz  		__B2_HD_00184					; to case
		comp		L0,#$d				; 
		jz  		__B2_HD_00183					; to case
		jump		__B2_HD_00185					; to default
__B2_HD_00181:
#DLINE 173 "JOBS\SEED_KEY.B2V"
		move		L0,#$0				; 
		push		L0					; 
		move		L0,#$1				; 
		push		L0					; 
		pop 		L1					; 
		pop 		L0					; 
		comp		L0,L1				; 
		jz  		__B2_HD_00193					; if condition true then true
		push		#0.L					; FALSE
		jump		__B2_HD_00194					; 
__B2_HD_00193:
		push		#1.L					; TRUE
__B2_HD_00194:
		pop 		L0					; get expression
		jz  		__B2_HD_00195					; IF
		nop 							; for debugging
#DLINE 174 "JOBS\SEED_KEY.B2V"
		clear		S1					; 
		move		S1,S6			;payload
		push		#1.L					; TRUE
		clear		S1					; 
		move		S1,S3			;key_answer
		push		#1.L					; TRUE
            gettmr      L6               ; trapmask=get_trap_mask()
            slen        I2,S6           ; datalen_daten = datalen(daten)
            comp        I2,#0            ; datalen_daten = 0 ?
            jz          B2_196_0io              ; ja -> iO
            comp        I2,#4            ; datalen_daten < 4 ?
            jl          B2_196_0nio_1           ; ja -> Fehler

            move        I0,#0            ; temp = 0
            move        B0,S6[#2]       ; temp = LLEN
            adds        B0,#3            ; temp = temp + 3
            comp        I0,I2            ; temp <> datalen_daten ?
            jnz         B2_196_0nio_1           ; ja -> Fehler

            serase      S6[#0],#3       ; Erste 3 Byte löschen

            settmr      #$400.L          ; set_trap_mask(0x400)
            tabset      "JobResult"      ; tabset("JobResult")
            jt          B2_196_0nio_table,#10   ; Tabelle nicht gefunden ?
            comp        S6[#0],#$7F     ; daten[0] == 0x7F ?
            jnz         B2_196_1               ; nein -> goto %1

            fix2hex     S1,S6[#2]       ;
            tabseek     "SB",S1          ; tab_suche_index("SB",daten[2])
            tabget      S1,"STATUS_TEXT" ;
            ergs        "JOB_STATUS",S1  ;
            jump        B2_196_0endnio          ; Fehler !

B2_196_1:         slen        I0,S3           ; temp = datalen(auftrag)
            comp        I0,#0            ; temp = 0 ?
            jz          B2_196_0io              ; ja -> Keine SID Überprüfung
            comp        S3[#0],#$B8     ; auftrag[0] == 0xB8 ?
            jz          B2_196_2               ; ja -> goto %2

            comp        I0,#7            ; temp < 7 ?
            jl          B2_196_0io              ; ja -> Keine SID Überprüfung
            move        B2,S3[#6]       ; SID = auftrag[6]
            adds        B2,#$40          ; SID = SID + 0x40
            comp        S6[#0],B2       ; daten[0] <> SID ?
            jnz         B2_196_0nio_2           ; ja -> Fehler
            jump        B2_196_0io              ; io

B2_196_2:         comp        I0,#8            ; temp < 8 ?
            jl          B2_196_0io              ; ja -> Keine SID Überprüfung
            move        B2,S3[#7]       ; SID = auftrag[7]
            adds        B2,#$40          ; SID = SID + 0x40
            comp        S6[#0],B2       ; daten[0] <> SID ?
            jnz         B2_196_0nio_2           ; ja -> Fehler
;           jump        %io              ; io

B2_196_0io:        push        #1.L             ; TRUE
            jump        B2_196_0end

B2_196_0nio_table: ergs        "JOB_MESSAGE","Table JobResult not found"
            ergs        "JOB_STATUS","ERROR_TABLE"
            clrt                         ; clear_error
            jump        B2_196_0endnio          ; Fehler !

B2_196_0nio_1:     ergs        "JOB_STATUS","ERROR_ECU_INCORRECT_LIN_LEN"
            jump        B2_196_0endnio          ; Fehler !

B2_196_0nio_2:     ergs        "JOB_STATUS","ERROR_ECU_INCORRECT_LIN_RESPONSE_ID"
            jump        B2_196_0endnio          ; Fehler !

B2_196_0endnio:    push        #0.L             ; FALSE
;           jump        %end

B2_196_0end:       settmr      L6               ; set_trap_mask(trapmask)
		pop 		L1					; 
		pop 		L0					; 
		pop 		L0					; 
		push		L1					; 
