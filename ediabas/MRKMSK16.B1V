#DLINE 176 "JOBS\SEED_KEY.B2V"
__B2_HD_00195:
#DLINE 178 "JOBS\SEED_KEY.B2V"
		etag		__B2_HD_00200,"STAT_SEED_KEY"		; REQUESTED
		push		#1.L					; TRUE
		jump		__B2_HD_00201					; 
__B2_HD_00200:
